# Video Generation Client Environment Variables
# Copy this file to .env and fill in your API tokens

# MuleRun API (api.mulerun.com) - supports all models
API_TOKEN=your-mulerun-api-key

# MuleRouter API (api.mulerouter.ai) - supports Nano Banana Pro only
MULEROUTER_API_TOKEN=your-mulerouter-api-key

API_PROXY=http://127.0.0.1:7890